{% assign current = data.weather %}
{% if current contains 'forecast' %}
  {% assign forecast = current.forecast %}
{% else %}
  {% assign forecast = nil %}
{% endif %}
{% assign today = nil %}
{% assign tomorrow = nil %}
{% for forecast_day in forecast limit: 2 %}
  {% if forloop.first %}
    {% assign today = forecast_day %}
  {% else %}
    {% assign tomorrow = forecast_day %}
  {% endif %}
{% endfor %}

<div class="od-weather">
  <section class="od-weather__composition od-weather__composition--expansive" data-weather-composition="expansive">
    <div class="layout layout--col gap--space-between">
      <div class="grid grid--cols-6">
        <div class="row row--center col--span-2 portrait:col--span-6 col--end">
          <img class="image--adaptive w--[22cqw] h--auto portrait:w--auto portrait:h--[40cqh] lg:w--[28cqw] lg:h--[28cqw] lg:portrait:w--auto lg:portrait:h--[33cqh]" alt="{{ current.condition_label }}" src="{{ current.icon }}">
        </div>
        <div class="col col--span-2 portrait:col--span-3 col--end">
          <div class="item grow">
            <div class="meta"></div>
            <div class="content">
              <span class="value value--xxxlarge lg:value--giga" data-fit-value="true">{{ current.temperature }}°</span>
              <span class="label">{{ current.labels.temperature }} ({{ current.updated_at }})</span>
            </div>
          </div>
        </div>
        <div class="col col--span-2 portrait:col--span-3 col--end gap--medium">
          {% if config.showFeelsLike and current.apparent_temperature != nil %}
          <div class="item">
            <div class="meta"></div>
            <div class="icon">
              <img class="image--adaptive w--[6cqw] h--[6cqw] portrait:w--[10cqw] portrait:h--[10cqw]" alt="{{ current.labels.temperature }}" src="https://trmnl.com/images/plugins/weather/wi-thermometer.svg">
            </div>
            <div class="content">
              <span class="value value--xsmall lg:value--large">{{ current.apparent_temperature }}°</span>
              <span class="label">{{ current.labels.apparent_temperature }}</span>
            </div>
          </div>
          {% endif %}
          {% if config.showHumidity and current.humidity != nil %}
          <div class="item">
            <div class="meta"></div>
            <div class="icon">
              <img class="image--adaptive w--[6cqw] h--[6cqw] portrait:w--[10cqw] portrait:h--[10cqw]" alt="{{ current.labels.humidity }}" src="https://trmnl.com/images/plugins/weather/wi-raindrops.svg">
            </div>
            <div class="content">
              <span class="value value--xsmall lg:value--large">{{ current.humidity }}%</span>
              <span class="label">{{ current.labels.humidity }}</span>
            </div>
          </div>
          {% endif %}
          <div class="item">
            <div class="meta"></div>
            <div class="icon">
              <img class="image--adaptive w--[6cqw] h--[6cqw] portrait:w--[10cqw] portrait:h--[10cqw]" alt="{{ current.condition_label }}" src="{{ current.icon }}">
            </div>
            <div class="content">
              <span class="value value--xsmall lg:value--base">{{ current.condition_label }}</span>
              <span class="label">{{ current.labels.right_now }}</span>
            </div>
          </div>
        </div>
      </div>

      {% if config.showForecast and forecast != nil and forecast != empty %}
      <div class="divider"></div>
      <div class="grid">
        <div class="col gap--large">
          {% for day in forecast limit: 2 %}
          <div class="grid">
            <div class="item col--span-3 grow">
              <div class="meta"></div>
              <div class="icon">
                <img class="image--adaptive w--[6cqw] h--[6cqw] portrait:w--[10cqw] portrait:h--[10cqw]" alt="{{ day.condition_label }}" src="{{ day.icon }}">
              </div>
              <div class="content">
                <span class="value value--xsmall lg:value--base">{{ day.condition_label }}</span>
                <span class="label">{{ day.date_label }}</span>
              </div>
            </div>
            {% if day.uv_index != nil or day.precipitation_probability != nil %}
            <div class="item col--span-3 grow">
              <div class="meta"></div>
              <div class="icon portrait:hidden">
                <img class="image--adaptive w--[6cqw] h--[6cqw] portrait:w--[10cqw] portrait:h--[10cqw]" alt="{% if day.uv_index != nil %}{{ current.labels.uv }}{% else %}{{ current.labels.precipitation }}{% endif %}" src="{% if day.uv_index != nil %}https://trmnl.com/images/plugins/weather/wi-hot.svg{% else %}https://trmnl.com/images/plugins/weather/wi-raindrops.svg{% endif %}">
              </div>
              <div class="content">
                <span class="value value--xsmall lg:value--base">{% if day.uv_index != nil %}{{ day.uv_label }} ({{ day.uv_index }}){% else %}{{ day.precipitation_probability }}%{% endif %}</span>
                <span class="label">{% if day.uv_index != nil %}{{ current.labels.uv }}{% else %}{{ current.labels.precipitation }}{% endif %}</span>
              </div>
            </div>
            {% endif %}
            <div class="row col--span-3 grow">
              <div class="item">
                <div class="meta"></div>
                <div class="icon portrait:hidden">
                  <img class="image--adaptive w--[6cqw] h--[6cqw] portrait:w--[10cqw] portrait:h--[10cqw]" alt="{{ current.labels.temperature }}" src="https://trmnl.com/images/plugins/weather/wi-thermometer.svg">
                </div>
                <div class="content">
                  <div class="flex flex--row gap--xlarge portrait:gap">
                    <div class="content">
                      <span class="value value--xsmall lg:value--base">{% if day.templow != nil %}{{ day.templow | round }}°{% else %}—{% endif %}</span>
                      <span class="label">{{ current.labels.low }}</span>
                    </div>
                    <div class="content">
                      <span class="value value--xsmall lg:value--base">{{ day.temperature | round }}°</span>
                      <span class="label">{{ current.labels.high }}</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}
    </div>
    <div class="title_bar">
      <img class="image image--adaptive" alt="" src="https://trmnl.com/images/plugins/weather--render.svg">
      <h1 class="title">{{ current.labels.weather }}</h1>
      <span class="instance">{{ current.name }}</span>
    </div>
  </section>

  <section class="od-weather__composition od-weather__composition--wide" data-weather-composition="wide">
    <div class="layout layout--col gap--space-between">
      <div class="grid grid--cols-4">
        <div class="row row--center lg:col">
          <img class="image--adaptive w--[22cqw] h--auto lg:w--[24cqw] lg:h--[24cqw]" alt="{{ current.condition_label }}" src="{{ current.icon }}">
        </div>
        <div class="col">
          <div class="item grow">
            <div class="meta"></div>
            <div class="content">
              <span class="value value--xxxlarge lg:value--giga" data-fit-value="true">{{ current.temperature }}°</span>
              <span class="label">{{ current.labels.temperature }}</span>
              <span class="label">{{ current.updated_at }}</span>
            </div>
          </div>
        </div>
        <div class="col gap--medium">
          <div class="item grow">
            <div class="meta"></div>
            <div class="content">
              <span class="value value--xsmall lg:value--base">{{ current.condition_label }}</span>
              <span class="label">{{ current.labels.right_now }}</span>
            </div>
          </div>
          {% if config.showForecast and today %}
          <div class="item grow">
            <div class="meta"></div>
            <div class="content">
              <span class="value value--xsmall lg:value--small">{% if today.templow != nil %}{{ today.templow }}° – {% endif %}{{ today.temperature }}°</span>
              <span class="label">{% if today.templow != nil %}{{ current.labels.low_high }}{% else %}{{ current.labels.high }}{% endif %}</span>
            </div>
          </div>
          <div class="item grow">
            <div class="meta"></div>
            <div class="content">
              <span class="value value--xsmall lg:value--small">{% if today.uv_index != nil %}{{ today.uv_label }} ({{ today.uv_index }}){% elsif today.precipitation_probability != nil %}{{ today.precipitation_probability }}%{% else %}—{% endif %}</span>
              <span class="label">{% if today.uv_index != nil %}{{ current.labels.uv }}{% elsif today.precipitation_probability != nil %}{{ current.labels.precipitation }}{% else %}{{ current.labels.details }}{% endif %}</span>
            </div>
          </div>
          {% endif %}
        </div>
        <div class="col gap--medium">
          {% if config.showForecast and tomorrow %}
          <div class="item grow">
            <div class="meta"></div>
            <div class="content">
              <span class="value value--xsmall lg:value--base">{{ tomorrow.condition_label }}</span>
              <span class="label">{{ current.labels.tomorrow }}</span>
            </div>
          </div>
          <div class="item grow">
            <div class="meta"></div>
            <div class="content">
              <span class="value value--xsmall lg:value--small">{% if tomorrow.templow != nil %}{{ tomorrow.templow }}° – {% endif %}{{ tomorrow.temperature }}°</span>
              <span class="label">{% if tomorrow.templow != nil %}{{ current.labels.low_high }}{% else %}{{ current.labels.high }}{% endif %}</span>
            </div>
          </div>
          <div class="item grow">
            <div class="meta"></div>
            <div class="content">
              <span class="value value--xsmall lg:value--small">{% if tomorrow.uv_index != nil %}{{ tomorrow.uv_label }} ({{ tomorrow.uv_index }}){% elsif tomorrow.precipitation_probability != nil %}{{ tomorrow.precipitation_probability }}%{% else %}—{% endif %}</span>
              <span class="label">{% if tomorrow.uv_index != nil %}{{ current.labels.uv }}{% elsif tomorrow.precipitation_probability != nil %}{{ current.labels.precipitation }}{% else %}{{ current.labels.details }}{% endif %}</span>
            </div>
          </div>
          {% endif %}
        </div>
      </div>
    </div>
    <div class="title_bar">
      <img class="image image--adaptive" alt="" src="https://trmnl.com/images/plugins/weather--render.svg">
      <h1 class="title">{{ current.updated_at }}</h1>
      <span class="instance">{{ current.name }}</span>
    </div>
  </section>

  <section class="od-weather__composition od-weather__composition--tall" data-weather-composition="tall">
    <div class="layout layout--col gap--space-between">
      <div class="grid grid--cols-2 portrait:grid--cols-1">
        <div class="row row--center">
          <img class="image--adaptive w--[46cqw] h--[46cqw] portrait:w--auto portrait:h--[22cqh] lg:w--[46cqw] lg:h--[46cqw] lg:portrait:w--auto lg:portrait:h--[32cqh]" alt="{{ current.condition_label }}" src="{{ current.icon }}">
        </div>
        <div class="col">
          <div class="item grow">
            <div class="meta"></div>
            <div class="content">
              <span class="value value--xxlarge lg:value--giga lg:portrait:value--mega" data-fit-value="true">{{ current.temperature }}°</span>
              <span class="label">{{ current.labels.temperature }}</span>
              <span class="label">{{ current.updated_at }}</span>
            </div>
          </div>
        </div>
      </div>
      {% if config.showForecast and forecast != nil and forecast != empty %}
      <div class="divider"></div>
      <div class="grid grid--cols-2 portrait:grid--cols-1 portrait:gap">
        {% for day in forecast limit: 2 %}
        {% if forloop.index == 2 %}<div class="divider landscape:hidden"></div>{% endif %}
        <div class="col gap--medium">
          <div class="item">
            <div class="meta"></div>
            <div class="content">
              <span class="value value--small lg:value--base">{% if forloop.first %}{{ current.condition_label }}{% else %}{{ day.condition_label }}{% endif %}</span>
              <span class="label">{% if forloop.first %}{{ current.labels.right_now }}{% else %}{{ current.labels.tomorrow }}{% endif %}</span>
            </div>
          </div>
          <div class="item">
            <div class="meta"></div>
            <div class="content">
              <span class="value value--xsmall lg:value--small lg:portrait:value--small">{% if day.templow != nil %}{{ day.templow }}° – {% endif %}{{ day.temperature }}°</span>
              <span class="label">{% if day.templow != nil %}{{ current.labels.low_high }}{% else %}{{ current.labels.high }}{% endif %}</span>
            </div>
          </div>
          <div class="item">
            <div class="meta"></div>
            <div class="content">
              <span class="value value--xsmall lg:value--small lg:portrait:value--small">{% if day.uv_index != nil %}{{ day.uv_label }} ({{ day.uv_index }}){% elsif day.precipitation_probability != nil %}{{ day.precipitation_probability }}%{% else %}—{% endif %}</span>
              <span class="label">{% if day.uv_index != nil %}{{ current.labels.uv }}{% elsif day.precipitation_probability != nil %}{{ current.labels.precipitation }}{% else %}{{ current.labels.details }}{% endif %}</span>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
    <div class="title_bar">
      <img class="image image--adaptive" alt="" src="https://trmnl.com/images/plugins/weather--render.svg">
      <h1 class="title">{{ current.updated_at }}</h1>
      <span class="instance">{{ current.name }}</span>
    </div>
  </section>

  <section class="od-weather__composition od-weather__composition--compact" data-weather-composition="compact">
    <div class="layout">
      <div class="grid grid--cols-2 portrait:grid--cols-1 gap--none lg:portrait:gap">
        <div class="col">
          <div class="row row--center">
            <img class="image--adaptive w--[46cqw] h--auto portrait:w--auto portrait:h--[50cqh] lg:w--[46cqw] lg:h--[46cqw] lg:portrait:w--auto lg:portrait:h--[46cqh]" alt="{{ current.condition_label }}" src="{{ current.icon }}">
          </div>
          <div class="hidden lg:flex lg:portrait:hidden h--full">
            <div class="item grow">
              <div class="meta"></div>
              <div class="content">
                <span class="value value--xsmall lg:value--base">{{ current.condition_label }}</span>
                <span class="label hidden lg:visible">{{ current.labels.right_now }}</span>
              </div>
            </div>
          </div>
        </div>
        <div class="col gap lg:portrait:grid lg:portrait:grid--cols-2">
          <div class="item grow">
            <div class="meta"></div>
            <div class="content">
              <span class="value value--large lg:value--xxxlarge" data-fit-value="true">{{ current.temperature }}°</span>
              <span class="label hidden lg:visible">{{ current.labels.temperature }}</span>
            </div>
          </div>
          <div class="visible lg:hidden lg:portrait:flex h--full">
            <div class="item grow">
              <div class="meta"></div>
              <div class="content">
                <span class="value value--xsmall lg:portrait:value--base">{{ current.condition_label }}</span>
                <span class="label hidden lg:visible">{{ current.labels.right_now }}</span>
              </div>
            </div>
          </div>
          {% if config.showForecast and today %}
          <div class="item">
            <div class="meta"></div>
            <div class="content">
              <span class="value value--xxsmall lg:value--small">{% if today.templow != nil %}{{ today.templow }}° – {% endif %}{{ today.temperature }}°</span>
              <span class="label hidden lg:visible">{% if today.templow != nil %}{{ current.labels.low_high }}{% else %}{{ current.labels.high }}{% endif %}</span>
            </div>
          </div>
          <div class="item">
            <div class="meta"></div>
            <div class="content">
              <span class="value value--xxsmall lg:value--small">{% if today.uv_index != nil %}{{ today.uv_label }} ({{ today.uv_index }}){% elsif today.precipitation_probability != nil %}{{ today.precipitation_probability }}%{% else %}—{% endif %}</span>
              <span class="label hidden lg:visible">{% if today.uv_index != nil %}{{ current.labels.uv }}{% elsif today.precipitation_probability != nil %}{{ current.labels.precipitation }}{% else %}{{ current.labels.details }}{% endif %}</span>
            </div>
          </div>
          {% endif %}
        </div>
      </div>
    </div>
    <div class="title_bar">
      <img class="image image--adaptive" alt="" src="https://trmnl.com/images/plugins/weather--render.svg">
      <h1 class="title">{{ current.updated_at }}</h1>
      <span class="instance">{{ current.name }}</span>
    </div>
  </section>

  <section class="od-weather__composition od-weather__composition--strip" data-weather-composition="strip">
    <div class="layout">
      <div class="od-weather__strip-content">
        <img class="image--adaptive" alt="{{ current.condition_label }}" src="{{ current.icon }}">
        <span class="value value--tnums" data-fit-value="true">{{ current.temperature }}°</span>
        <div class="od-weather__strip-summary">
          <span class="value">{{ current.condition_label }}</span>
          <span class="label">{{ current.labels.right_now }}</span>
        </div>
      </div>
    </div>
    <div class="title_bar">
      <img class="image image--adaptive" alt="" src="https://trmnl.com/images/plugins/weather--render.svg">
      <h1 class="title">{{ current.updated_at }}</h1>
      <span class="instance">{{ current.name }}</span>
    </div>
  </section>

  <section class="od-weather__composition od-weather__composition--minimal" data-weather-composition="minimal">
    <div class="layout">
      <div class="od-weather__minimal-content">
        <img class="image--adaptive" alt="{{ current.condition_label }}" src="{{ current.icon }}">
        <span class="value">{{ current.temperature }}°</span>
      </div>
    </div>
    <div class="title_bar">
      <img class="image image--adaptive" alt="" src="https://trmnl.com/images/plugins/weather--render.svg">
      <h1 class="title">{{ current.updated_at }}</h1>
      <span class="instance">{{ current.name }}</span>
    </div>
  </section>
</div>

<style>
  .od-weather {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    container-type: size;
    container-name: weather;
    overflow: hidden;
  }

  .od-weather__composition {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    display: none;
    grid-template-rows: minmax(0, 1fr) auto;
    overflow: hidden;
  }

  .od-weather__composition > .layout {
    width: 100%;
    height: auto !important;
    min-width: 0;
    min-height: 0;
    padding: var(--gap);
    overflow: hidden;
  }

  .od-weather__composition:not(.od-weather__composition--expansive) > .title_bar {
    height: var(--title-bar-small-height);
  }

  .od-weather__composition:not(.od-weather__composition--expansive) > .title_bar img {
    height: var(--title-bar-small-image-height);
  }

  .od-weather__composition--compact {
    display: grid;
  }

  .od-weather__minimal-content {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }

  .od-weather__strip-content {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(8px, 3cqw, 28px);
    overflow: hidden;
  }

  .od-weather__strip-content > img {
    width: min(21cqw, 88px);
    height: min(62cqh, 88px);
    flex: 0 1 auto;
    object-fit: contain;
  }

  .od-weather__strip-content > .value {
    flex: 0 1 auto;
    font-size: clamp(
      calc(28px * var(--text-ui-scale, 1)),
      calc(12cqw * var(--text-ui-scale, 1)),
      calc(64px * var(--text-ui-scale, 1))
    );
    line-height: 0.9;
    white-space: nowrap;
  }

  .od-weather__strip-summary {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow: hidden;
  }

  .od-weather__strip-summary > span {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .od-weather__minimal-content img {
    width: min(78cqw, 145px);
    height: min(60cqh, 120px);
    object-fit: contain;
  }

  .od-weather__minimal-content .value {
    font-size: clamp(
      calc(38px * var(--text-ui-scale, 1)),
      calc(25cqw * var(--text-ui-scale, 1)),
      calc(56px * var(--text-ui-scale, 1))
    );
    line-height: 1;
    white-space: nowrap;
  }

  @container weather (min-width: 480px) and (max-height: 339px) {
    .od-weather__composition { display: none; }
    .od-weather__composition--wide { display: grid; }
  }

  @container weather (min-width: 361px) and (max-height: 199px) {
    .od-weather__composition { display: none; }
    .od-weather__composition--strip { display: grid; }
  }

  @container weather (min-width: 300px) and (max-width: 619px) and (min-height: 340px) {
    .od-weather__composition { display: none; }
    .od-weather__composition--tall { display: grid; }
  }

  @container weather (min-width: 620px) and (min-height: 340px) {
    .od-weather__composition { display: none; }
    .od-weather__composition--expansive { display: grid; }
  }

  @container weather (min-width: 400px) and (min-height: 620px) {
    .od-weather__composition { display: none; }
    .od-weather__composition--expansive { display: grid; }
  }

  @container weather (max-width: 240px) {
    .od-weather .title_bar .instance { display: none; }
  }

  @container weather (max-width: 240px) and (max-height: 299px) {
    .od-weather__composition { display: none; }
    .od-weather__composition--minimal { display: grid; }
  }

  @container weather (max-width: 360px) and (max-height: 220px) {
    .od-weather__composition { display: none; }
    .od-weather__composition--minimal { display: grid; }
  }

  @container weather (max-width: 240px) and (min-height: 300px) {
    .od-weather__composition--compact .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .od-weather__composition--compact .row img {
      width: auto;
      height: min(38cqh, 160px);
    }
  }
</style>

<div class="od-weather">
  <div class="od-weather__body">
    <section class="od-weather__current">
      <div class="od-weather__hero-icon">
        <img class="image image--adaptive" alt="{{ data.current.condition }}" src="{{ data.current.icon }}">
      </div>

      <div class="od-weather__temperature">
        <div class="od-weather__temperature-value">{{ data.current.temperature }}°</div>
        <div class="od-weather__temperature-label">Temperature ({{ data.current.observed_at }})</div>
      </div>

      <div class="od-weather__details">
        {% if config.show_feels_like %}
        <div class="od-weather__detail">
          <img class="image image--adaptive" alt="Temperature" src="https://trmnl.com/images/plugins/weather/wi-thermometer.svg">
          <div>
            <div class="od-weather__detail-value">{{ data.current.feels_like }}°</div>
            <div class="od-weather__detail-label">Feels Like</div>
          </div>
        </div>
        {% endif %}

        {% if config.show_humidity %}
        <div class="od-weather__detail">
          <img class="image image--adaptive" alt="Humidity" src="https://trmnl.com/images/plugins/weather/wi-raindrops.svg">
          <div>
            <div class="od-weather__detail-value">{{ data.current.humidity }}%</div>
            <div class="od-weather__detail-label">Humidity</div>
          </div>
        </div>
        {% endif %}

        <div class="od-weather__detail">
          <img class="image image--adaptive" alt="{{ data.current.condition }}" src="{{ data.current.icon }}">
          <div>
            <div class="od-weather__detail-value od-weather__detail-value--condition">{{ data.current.condition }}</div>
            <div class="od-weather__detail-label">Right Now</div>
          </div>
        </div>
      </div>
    </section>

    {% if config.show_forecast %}
    <section class="od-weather__forecast">
      {% for day in data.forecast limit: 2 %}
      <article class="od-weather__forecast-day">
        <div class="od-weather__forecast-condition">
          <img class="image image--adaptive" alt="{{ day.condition }}" src="{{ day.icon }}">
          <div>
            <div class="od-weather__forecast-title">{{ day.condition }}</div>
            <div class="od-weather__forecast-date">{{ day.date }}</div>
          </div>
        </div>

        <div class="od-weather__forecast-uv">
          <img class="image image--adaptive" alt="UV Index" src="https://trmnl.com/images/plugins/weather/wi-hot.svg">
          <div>
            <div class="od-weather__forecast-title">{{ day.uv_label }} ({{ day.uv }})</div>
            <div class="od-weather__forecast-date">UV</div>
          </div>
        </div>

        <div class="od-weather__forecast-temp">
          <img class="image image--adaptive" alt="Temperature" src="https://trmnl.com/images/plugins/weather/wi-thermometer.svg">
          <div class="od-weather__minmax">
            <div><strong>{{ day.low }}°</strong><span>Low</span></div>
            <div><strong>{{ day.high }}°</strong><span>High</span></div>
          </div>
        </div>
      </article>
      {% endfor %}
    </section>
    {% endif %}
  </div>

  <div class="title_bar">
    <img class="image image--adaptive" alt="" src="https://trmnl.com/images/plugins/weather--render.svg">
    <h1 class="title">Weather</h1>
    <span class="instance">{{ data.location }}</span>
  </div>
</div>

<style>
  .od-weather {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    container-type: size;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    overflow: hidden;
  }

  .od-weather__body {
    min-width: 0;
    min-height: 0;
    display: grid;
    grid-template-rows: minmax(0, 1.05fr) auto;
    gap: 12px;
    padding-bottom: 4px;
  }

  .od-weather__current {
    min-height: 0;
    display: grid;
    grid-template-columns: 1fr 1.15fr 1fr;
    align-items: center;
    gap: 18px;
  }

  .od-weather__hero-icon,
  .od-weather__temperature,
  .od-weather__details {
    min-width: 0;
    min-height: 0;
  }

  .od-weather__hero-icon {
    height: 100%;
    display: grid;
    place-items: center;
    border-right: 2px solid var(--gray-2, #ddd);
  }

  .od-weather__hero-icon img {
    width: min(72%, 190px);
    height: auto;
    max-height: 82%;
  }

  .od-weather__temperature {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-right: 2px solid var(--gray-2, #ddd);
  }

  .od-weather__temperature-value {
    font-size: clamp(56px, 13cqw, 138px);
    line-height: .88;
    letter-spacing: -.065em;
    white-space: nowrap;
  }

  .od-weather__temperature-label,
  .od-weather__detail-label,
  .od-weather__forecast-date,
  .od-weather__minmax span {
    font-size: clamp(9px, 1.5cqw, 15px);
    opacity: .8;
  }

  .od-weather__details {
    display: grid;
    align-content: center;
    gap: 10px;
  }

  .od-weather__detail {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
  }

  .od-weather__detail img,
  .od-weather__forecast-condition img,
  .od-weather__forecast-uv img,
  .od-weather__forecast-temp img {
    width: 30px;
    height: 30px;
    object-fit: contain;
  }

  .od-weather__detail-value,
  .od-weather__forecast-title,
  .od-weather__minmax strong {
    font-size: clamp(16px, 3.3cqw, 30px);
    line-height: 1;
  }

  .od-weather__detail-value--condition {
    font-size: clamp(14px, 2.4cqw, 24px);
  }

  .od-weather__forecast {
    border-top: 1px solid var(--gray-2, #ddd);
    padding-top: 10px;
    display: grid;
    gap: 8px;
  }

  .od-weather__forecast-day {
    display: grid;
    grid-template-columns: 1.25fr 1fr .9fr;
    align-items: center;
    gap: 12px;
  }

  .od-weather__forecast-condition,
  .od-weather__forecast-uv,
  .od-weather__forecast-temp {
    min-width: 0;
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr);
    align-items: center;
    gap: 7px;
    border-right: 2px solid var(--gray-2, #ddd);
  }

  .od-weather__forecast-temp {
    border-right: 0;
  }

  .od-weather__minmax {
    display: flex;
    gap: 14px;
  }

  .od-weather__minmax > div {
    display: grid;
  }

  @container (max-height: 290px) and (min-width: 520px) {
    .od-weather__body {
      grid-template-columns: 1.25fr 1fr;
      grid-template-rows: minmax(0, 1fr);
      gap: 14px;
    }

    .od-weather__current {
      grid-template-columns: .9fr 1.1fr;
      gap: 12px;
    }

    .od-weather__details {
      display: none;
    }

    .od-weather__forecast {
      border-top: 0;
      border-left: 1px solid var(--gray-2, #ddd);
      padding: 0 0 0 12px;
      align-content: center;
    }

    .od-weather__forecast-day {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .od-weather__forecast-uv,
    .od-weather__forecast-temp {
      display: none;
    }

    .od-weather__forecast-condition {
      border-right: 0;
      grid-template-columns: 28px 1fr;
    }
  }

  @container (max-width: 520px) and (min-height: 300px) {
    .od-weather__body {
      grid-template-rows: auto minmax(0, 1fr);
      gap: 10px;
    }

    .od-weather__current {
      grid-template-columns: .8fr 1.2fr;
      gap: 10px;
    }

    .od-weather__details {
      display: none;
    }

    .od-weather__hero-icon img {
      width: 72%;
    }

    .od-weather__forecast-day {
      grid-template-columns: 1fr;
      gap: 5px;
      align-content: center;
    }

    .od-weather__forecast {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-top: 1px solid var(--gray-2, #ddd);
      padding-top: 8px;
    }

    .od-weather__forecast-condition,
    .od-weather__forecast-uv {
      border-right: 0;
      grid-template-columns: 24px minmax(0, 1fr);
    }

    .od-weather__forecast-temp {
      display: none;
    }

    .od-weather__forecast-condition img,
    .od-weather__forecast-uv img {
      width: 23px;
      height: 23px;
    }
  }

  @container (max-width: 300px) {
    .od-weather__body {
      grid-template-rows: auto minmax(0, 1fr);
      gap: 7px;
    }

    .od-weather__current {
      grid-template-columns: .72fr 1.28fr;
      gap: 7px;
    }

    .od-weather__hero-icon {
      border-right-width: 1px;
    }

    .od-weather__temperature {
      border-right: 0;
    }

    .od-weather__temperature-value {
      font-size: clamp(40px, 28cqw, 76px);
    }

    .od-weather__temperature-label {
      font-size: 8px;
    }

    .od-weather__details {
      display: none;
    }

    .od-weather__forecast {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 5px;
      padding-top: 6px;
    }

    .od-weather__forecast-day {
      display: block;
      min-width: 0;
    }

    .od-weather__forecast-condition {
      display: grid;
      grid-template-columns: 20px minmax(0, 1fr);
      gap: 4px;
      border-right: 0;
    }

    .od-weather__forecast-condition img {
      width: 19px;
      height: 19px;
    }

    .od-weather__forecast-title {
      font-size: 10px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .od-weather__forecast-date {
      font-size: 7px;
    }

    .od-weather__forecast-uv,
    .od-weather__forecast-temp {
      display: none;
    }

    .title_bar .instance {
      display: none;
    }
  }

  @container (max-width: 240px) and (max-height: 280px) {
    .od-weather__body {
      display: block;
    }

    .od-weather__current {
      width: 100%;
      height: 100%;
      grid-template-columns: .7fr 1.3fr;
    }

    .od-weather__forecast {
      display: none;
    }

    .od-weather__hero-icon img {
      width: 78%;
    }

    .od-weather__temperature-value {
      font-size: clamp(38px, 29cqw, 62px);
    }
  }
</style>
